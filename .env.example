# Copy to .env and fill in. ALL values are optional — the app runs with
# local fallbacks when none are set.

# Host binding for the server (serves API + built PWA on one port)
HOST=0.0.0.0
PORT=8000

# Optional shared access token for the LAN (leave empty to disable)
ACCESS_TOKEN=

# --- AI providers (first available wins; no US LLM providers) ---
# Mistral AI — EU-hosted, GDPR-compliant. Uses the API key from your existing
# Mistral plan (La Plateforme). Optional: without it, Ollama is used instead.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MISTRAL_VISION_MODEL=pixtral-large-latest
MISTRAL_EMBED_MODEL=mistral-embed

# Local fallback (fully offline): Ollama running on the host, incl. local
# Whisper for speech-to-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
WHISPER_MODEL=base

# --- Email (end-of-session character sheets) ---
# Any SMTP provider you already use.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Leave SMTP_HOST empty to write emails to ./outbox/ instead of sending.

# Database (defaults to ./data/app.db)
DATABASE_URL=sqlite:///./data/app.db
