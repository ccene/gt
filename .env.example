# Copy to .env and fill in. ALL values are optional — the app runs with
# local fallbacks when none are set.

# Host binding for the server (serves API + built PWA on one port)
HOST=0.0.0.0
PORT=8000

# Optional shared access token for the LAN (leave empty to disable)
ACCESS_TOKEN=

# --- AI providers (free tiers, first available wins) ---
GROQ_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
HUGGINGFACE_API_KEY=

# Local fallback (fully offline): point at Ollama running on the host
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Email (end-of-session character sheets) ---
# Any free SMTP, e.g. Gmail with an app password, or Resend free tier.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Leave SMTP_HOST empty to write emails to ./outbox/ instead of sending.

# Database (defaults to ./data/app.db)
DATABASE_URL=sqlite:///./data/app.db
